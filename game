<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>落ち物回避ゲーム</title>
    <style>
        body {
            margin: 0;
            background-color: #222;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: white;
            font-family: sans-serif;
            overflow: hidden;
        }
        #gameContainer {
            text-align: center;
        }
        canvas {
            background-color: #111;
            border: 4px solid #fff;
            display: block;
        }
        #scoreBoard {
            font-size: 24px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

<div id="gameContainer">
    <div id="scoreBoard">SCORE: <span id="score">0</span></div>
    <canvas id="gameCanvas" width="400" height="500"></canvas>
</div>

<script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");
    const scoreElement = document.getElementById("score");

    // ゲームの状態
    let score = 0;
    let gameOver = false;

    // プレイヤーの設定
    const player = {
        x: canvas.width / 2 - 15,
        y: canvas.height - 40,
        width: 30,
        height: 30,
        speed: 8,
        color: "#00FFCC"
    };

    // 障害物の設定
    const obstacles = [];
    const obstacleSpawnRate = 0.03; // スポーン確率（毎フレーム）
    const obstacleSpeedBase = 3;   // 初期速度

    // キー入力の監視
    const keys = {
        ArrowLeft: false,
        ArrowRight: false
    };

    window.addEventListener("keydown", (e) => {
        if (e.key in keys) keys[e.key] = true;
        if (gameOver && e.key === " ") restartGame();
    });

    window.addEventListener("keyup", (e) => {
        if (e.key in keys) keys[e.key] = false;
    });

    // 障害物の生成
    function spawnObstacle() {
        if (Math.random() < obstacleSpawnRate) {
            const size = Math.random() * 20 + 15; // サイズをランダムに
            obstacles.push({
                x: Math.random() * (canvas.width - size),
                y: -size,
                width: size,
                height: size,
                speed: obstacleSpeedBase + Math.random() * 3 + (score * 0.1), // スコアに応じて加速
                color: "#FF3366"
            });
        }
    }

    // 衝突判定
    function checkCollision(rect1, rect2) {
        return rect1.x < rect2.x + rect2.width &&
               rect1.x + rect1.width > rect2.x &&
               rect1.y < rect2.y + rect2.height &&
               rect1.y + rect1.height > rect2.y;
    }

    // ゲームの更新処理
    function update() {
        if (gameOver) return;

        // プレイヤーの移動
        if (keys.ArrowLeft && player.x > 0) {
            player.x -= player.speed;
        }
        if (keys.ArrowRight && player.x < canvas.width - player.width) {
            player.x += player.speed;
        }

        // 障害物の管理
        spawnObstacle();

        for (let i = obstacles.length - 1; i >= 0; i--) {
            const obs = obstacles[i];
            obs.y += obs.speed; // 落下

            // 衝突したらゲームオーバー
            if (checkCollision(player, obs)) {
                gameOver = true;
            }

            // 画面外に出たら削除してスコア加算
            if (obs.y > canvas.height) {
                obstacles.splice(i, 1);
                score += 10;
                scoreElement.textContent = score;
            }
        }
    }

    // 画面の描画処理
    function draw() {
        // 画面クリア
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // プレイヤー描画
        ctx.fillStyle = player.color;
        ctx.fillRect(player.x, player.y, player.width, player.height);

        // 障害物描画
        for (const obs of obstacles) {
            ctx.fillStyle = obs.color;
            ctx.fillRect(obs.x, obs.y, obs.width, obs.height);
        }

        // ゲームオーバー画面
        if (gameOver) {
            ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = "white";
            ctx.font = "30px sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("GAME OVER", canvas.width / 2, canvas.height / 2 - 20);
            
            ctx.font = "18px sans-serif";
            ctx.fillText("スペースキーでリスタート", canvas.width / 2, canvas.height / 2 + 20);
        }
    }

    // ゲームループ
    function gameLoop() {
        update();
        draw();
        requestAnimationFrame(gameLoop);
    }

    // ゲームのリスタート
    function restartGame() {
        score = 0;
        scoreElement.textContent = score;
        obstacles.length = 0;
        player.x = canvas.width / 2 - 15;
        gameOver = false;
    }

    // ゲーム開始
    gameLoop();
</script>

</body>
</html>
